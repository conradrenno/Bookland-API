<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devrenno</groupId>
        <artifactId>bookland</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>bookland-web-support</artifactId>
    <name>Bookland - Web Support</name>
    <description>
        Platform library: HTTP error-contract glue shared by every module (RFC 7807 problem+json).
        Contains framework infrastructure only — no domain types, no business rules, and no
        dependency on any other bookland module. Only *.infrastructure packages may use it.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>

        <!-- Optional: only the module that publishes an OpenAPI document needs this on its
             classpath, and it instantiates ErrorResponsesCustomizer itself. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
