# =============================================================================
# Bookland — template de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------------
POSTGRES_USER=bookland
POSTGRES_PASSWORD=your_db_password_here

# A URL do banco NÃO se configura aqui: o docker-compose já injeta
# DB_URL=jdbc:postgresql://postgres:5432/bookland no container da aplicação
# (o host é o nome do serviço na rede do compose, não localhost).
# Rodando a app pelo host contra o Postgres do compose, o default do
# application.yml (localhost:5432) já resolve — nada a fazer.

# POSTGRES_USER/PASSWORD acima são o SUPERUSUÁRIO do Postgres: só administração,
# nenhum serviço conecta com eles. Cada serviço tem role própria, dona só do seu
# database e sem CONNECT nos outros, criadas por docker/postgres/initdb — só na
# primeira subida do volume (depois de docker compose down -v).
APP_DB_USER=bookland_app
APP_DB_PASSWORD=your_app_db_password_here
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=your_identity_db_password_here
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=your_catalog_db_password_here
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=your_notification_db_password_here

# --- OAuth2 / Authorization Server (serviço identity, porta 9000) ------------
# URL pela qual os clientes realmente alcançam o identity. Vai no documento de discovery e no
# claim "iss"; a API confere o mesmo valor. Se não bater, o erro só aparece na validação do token.
# 127.0.0.1, não localhost — os redirect URIs são 127.0.0.1 (RFC 8252).
OAUTH2_ISSUER=http://127.0.0.1:9000

# Par de chaves RSA que assina os tokens: base64 do DER, numa linha só.
# A PRIVADA é o segredo do sistema inteiro — quem a tem fabrica tokens de admin.
# Gere um par novo com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out k.der
#   openssl pkcs8 -topk8 -nocrypt -inform DER -in k.der -outform DER -out private.der
#   openssl rsa -in k.der -inform DER -pubout -outform DER -out public.der
#   openssl base64 -A -in private.der    # → OAUTH2_JWK_PRIVATE_KEY
#   openssl base64 -A -in public.der     # → OAUTH2_JWK_PUBLIC_KEY
OAUTH2_JWK_PRIVATE_KEY=your_base64_pkcs8_private_key_here
OAUTH2_JWK_PUBLIC_KEY=your_base64_x509_public_key_here

# O client registrado (o front-end). O segredo vai em texto puro: o ClientBootstrap aplica
# BCrypt antes de gravar. Gere um com: openssl rand -base64 32
OAUTH2_CLIENT_ID=bookland-web
OAUTH2_CLIENT_SECRET=your_client_secret_here

# Separadas por vírgula. Use 127.0.0.1 e não "localhost": o servidor recusa o nome literal
# (RFC 8252). Uma por Swagger UI: o da API (8083 — a 8080 é do gateway), o do catalog (8082) e o
# do próprio identity (9000).
OAUTH2_CLIENT_REDIRECT_URIS=http://127.0.0.1:8083/swagger-ui/oauth2-redirect.html,http://127.0.0.1:9000/swagger-ui/oauth2-redirect.html,http://127.0.0.1:8082/swagger-ui/oauth2-redirect.html

# Origens de navegador que podem chamar /oauth2/token por fetch — os Swaggers da API e do catalog,
# em outras portas. Default no compose: http://127.0.0.1:8083,http://127.0.0.1:8082
# OAUTH2_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8083,http://127.0.0.1:8082

# Opcionais (defaults do application.yml):
# OAUTH2_ACCESS_TOKEN_TTL_MINUTES=15
# OAUTH2_REFRESH_TOKEN_TTL_DAYS=7

# --- Admin inicial ------------------------------------------------------------
# Criado automaticamente no boot se não existir (AdminBootstrap).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here

# --- RabbitMQ (fila de e-mails do serviço notification) ------------------------
# Usuário criado pela imagem na primeira subida. Default no compose e no dev: bookland/bookland.
# Painel em http://localhost:15672. E-mails "enviados" aparecem no Mailpit: http://localhost:8025
# RABBITMQ_USER=bookland
# RABBITMQ_PASSWORD=your_rabbitmq_password_here
