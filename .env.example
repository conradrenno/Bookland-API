# =============================================================================
# Bookland — environment variables for the Docker Compose stack (prod profile)
# Copy this file to .env and fill in the values before `docker compose up`.
# .env must never be committed (it is in .gitignore).
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=bookland
POSTGRES_PASSWORD=your_db_password_here

# The database URL is NOT set here: docker-compose injects each service's DB_URL
# (jdbc:postgresql://postgres:5432/<database> — the host is the compose service name,
# not localhost). Running a service from the host against the compose PostgreSQL, the
# application.yml default (localhost:5432) already works.

# POSTGRES_USER/PASSWORD above are PostgreSQL's SUPERUSER: administration only, no service
# connects with them. Each service has a role of its own that owns only its database and
# cannot connect to the others'. They are created by docker/postgres/initdb, and only on the
# volume's first start (after `docker compose down -v`).
APP_DB_USER=bookland_app
APP_DB_PASSWORD=your_app_db_password_here
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=your_identity_db_password_here
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=your_catalog_db_password_here
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=your_notification_db_password_here

# --- OAuth2 / Authorization Server (identity service, port 9000) -------------
# The URL clients actually reach the identity service on. It goes into the discovery document
# and the "iss" claim, and every service checks the same value — a mismatch only shows up when a
# token is validated. 127.0.0.1, not localhost: the redirect URIs are loopback IPs (RFC 8252).
OAUTH2_ISSUER=http://127.0.0.1:9000

# The RSA key pair that signs the tokens: base64 of the DER, on a single line.
# The PRIVATE key is the secret of the whole system — whoever holds it can mint admin tokens.
# Generate a new pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out k.der
#   openssl pkcs8 -topk8 -nocrypt -inform DER -in k.der -outform DER -out private.der
#   openssl rsa -in k.der -inform DER -pubout -outform DER -out public.der
#   openssl base64 -A -in private.der    # → OAUTH2_JWK_PRIVATE_KEY
#   openssl base64 -A -in public.der     # → OAUTH2_JWK_PUBLIC_KEY
OAUTH2_JWK_PRIVATE_KEY=your_base64_pkcs8_private_key_here
OAUTH2_JWK_PUBLIC_KEY=your_base64_x509_public_key_here

# The registered client (the front end, or the Swagger UIs). The secret is in plain text here:
# ClientBootstrap BCrypts it before storing it. Generate one with: openssl rand -base64 32
OAUTH2_CLIENT_ID=bookland-web
OAUTH2_CLIENT_SECRET=your_client_secret_here

# Comma-separated. Use 127.0.0.1, not "localhost": the server refuses the name (RFC 8252).
# The Next.js BFF's callback (Bookland-web, on 3000), then one per Swagger UI: the API's (8083 —
# 8080 is the gateway), the catalog's (8082) and the identity service's own (9000).
# ClientBootstrap only creates the client when it does not exist: a change here reaches an existing
# database only after `docker compose down -v` (or an update of oauth2_registered_client).
OAUTH2_CLIENT_REDIRECT_URIS=http://127.0.0.1:3000/api/auth/callback,http://127.0.0.1:8083/swagger-ui/oauth2-redirect.html,http://127.0.0.1:9000/swagger-ui/oauth2-redirect.html,http://127.0.0.1:8082/swagger-ui/oauth2-redirect.html

# Where /connect/logout may send the browser back to. Compose default: the BFF's home page.
# OAUTH2_CLIENT_POST_LOGOUT_REDIRECT_URIS=http://127.0.0.1:3000/

# Browser origins allowed to call /oauth2/token with fetch — the API's and the catalog's Swagger
# UIs, on other ports. Compose default: http://127.0.0.1:8083,http://127.0.0.1:8082
# OAUTH2_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8083,http://127.0.0.1:8082

# Optional (application.yml defaults):
# OAUTH2_ACCESS_TOKEN_TTL_MINUTES=15
# OAUTH2_REFRESH_TOKEN_TTL_DAYS=7

# --- First admin --------------------------------------------------------------
# Created on startup if it does not exist (AdminBootstrap).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here

# --- Sample books (catalog service) ------------------------------------------
# Ten sample books seeded on startup, idempotently by ISBN. Compose default: true.
# SEED_SAMPLE_BOOKS=false

# --- RabbitMQ (the notification service's e-mail queue) ----------------------
# The user the image creates on its first start. Default in compose and dev: bookland/bookland.
# Management UI at http://localhost:15672; e-mails "sent" show up in Mailpit: http://localhost:8025
# RABBITMQ_USER=bookland
# RABBITMQ_PASSWORD=your_rabbitmq_password_here
