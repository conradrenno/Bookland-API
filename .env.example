# =============================================================================
# Bookland — template de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------------
POSTGRES_USER=bookland
POSTGRES_PASSWORD=your_db_password_here

# --- JWT ----------------------------------------------------------------------
# Chave HMAC-SHA256 em Base64. Mínimo 256 bits (32 bytes).
# Gere uma nova com: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret_here

# Tempo de validade do access token em ms  (padrão: 86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# Tempo de validade do refresh token em ms (padrão: 604800000 = 7 dias)
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Admin inicial ------------------------------------------------------------
# Criado automaticamente no boot se não existir (AdminBootstrap).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here