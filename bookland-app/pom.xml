<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devrenno</groupId>
        <artifactId>bookland</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>bookland-app</artifactId>
    <name>Bookland - Application Bootstrap</name>

    <dependencies>
        <!-- Shared HTTP error contract. Declared explicitly rather than picked up transitively:
             the global validation advice has to be on the classpath of the running app. -->
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-web-support</artifactId>
        </dependency>

        <!-- Domain modules -->
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-orders</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-reviews</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-wishlist</artifactId>
        </dependency>
        <dependency>
            <groupId>com.devrenno</groupId>
            <artifactId>bookland-payments</artifactId>
        </dependency>

        <!-- Database drivers — H2 in dev, PostgreSQL in prod -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations — owns the schema in prod; Hibernate only validates.
             The starter is required: in Boot 4 the auto-configuration lives in the
             spring-boot-flyway module, not in flyway-core. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SpringDoc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc, for the error-contract test: the 401/403 behaviour lives in the security
             filter chain, which no mocked-port unit test can reach. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
